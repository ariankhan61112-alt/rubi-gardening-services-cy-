            e.preventDefault();
            const name = document.getElementById('name').value;
            const phone = document.getElementById('phone').value;
            const service = document.getElementById('service').value;
            const message = document.getElementById('message').value;

            const text = `Hello Rubi,%0A%0AI need a quote for your service:%0A- *Name:* ${name}%0A- *Phone:* ${phone}%0A- *Service Needed:* ${service}%0A- *Message:* ${message}`;
            window.open(`https://wa.me/35794003258?text=${text}`, '_blank');
        }

        // English / Greek Language Toggle
        let currentLang = 'en';
        function toggleLanguage() {
            const enElements = document.querySelectorAll('.lang-en');
            const elElements = document.querySelectorAll('.lang-el');

            if (currentLang === 'en') {
                enElements.forEach(el => el.style.display = 'none');
                elElements.forEach(el => el.style.display = 'inline-block');
                currentLang = 'el';
            } else {
                elElements.forEach(el => el.style.display = 'none');
                enElements.forEach(el => el.style.display = 'inline-block');
                currentLang = 'en';
            }
        }
